# 复制为 infra/.env.prod 后替换所有 change_me 值；不要提交真实生产密钥。
TZ=Asia/Shanghai
APP_VERSION=local

# Gateway 默认只监听本机，由同机 TLS 反向代理接入。
# 外部负载均衡器部署在其他主机时，改为宿主机私网 IP；不要直接暴露明文 HTTP 到公网。
ADMIN_GATEWAY_BIND=127.0.0.1
ADMIN_GATEWAY_PORT=8080
CLIENT_GATEWAY_BIND=127.0.0.1
CLIENT_GATEWAY_PORT=8082

MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
DB_USERNAME=ruoyi
DB_PASSWORD=change_me_database_password
REDIS_PASSWORD=change_me_redis_password

# Admin 与 Client 必须使用不同的 JWT 密钥。
ADMIN_JWT_SECRET=change_me_admin_jwt_secret_at_least_32_chars
CLIENT_JWT_SECRET=change_me_client_jwt_secret_at_least_32_chars

# 两侧 RSA 密钥必须分别与对应前端成对配置，值为无换行的 Base64。
ADMIN_API_DECRYPT_PUBLIC_KEY=change_me_admin_rsa_public_key
ADMIN_API_DECRYPT_PRIVATE_KEY=change_me_admin_rsa_private_key
CLIENT_API_DECRYPT_PUBLIC_KEY=change_me_client_rsa_public_key
CLIENT_API_DECRYPT_PRIVATE_KEY=change_me_client_rsa_private_key

ADMIN_JAVA_OPTS=-Xms512m -Xmx1024m
CLIENT_JAVA_OPTS=-Xms512m -Xmx1024m

# Client 短信服务默认关闭；启用时将开关改为 true，并填写供应商所需凭据。
CLIENT_SMS_ENABLED=false
CLIENT_SMS_SUPPLIER=alibaba
CLIENT_SMS_ACCESS_KEY_ID=
CLIENT_SMS_ACCESS_KEY_SECRET=
CLIENT_SMS_SIGNATURE=
CLIENT_SMS_SDK_APP_ID=

# 不启用微信小程序登录时可留空；启用时必须配置。
CLIENT_WECHAT_MINIAPP_APP_ID=
CLIENT_WECHAT_MINIAPP_APP_SECRET=
