# h5 通用环境变量（环境专属的 API 入口分别放在 .env.development/.env.production）

# H5 产品用户客户端 id（须与 client_application 表一致）
VITE_APP_CLIENT_ID=8f6e7d5c4b3a2910fedcba9876543210

# 是否开启登录/注册请求体加密（对应后端 @ApiEncrypt）
VITE_APP_ENCRYPT=true

# RSA 密钥对：与后端 application.yml 的 crypto.public-key / private-key 一致
# 公钥用于加密请求体的 AES 密钥；私钥用于解密响应头 encrypt-key 取回 AES 密钥
VITE_APP_RSA_PUBLIC_KEY=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDvEDuRIOM3oZPWj9Ukoc5pQklR4PFH6/clnjeFqjDLIgDyQvjxhgqAZQA+E9eD6qu6FsXPmK8djcL+nh3cFHz4pX473jDvO3Sve+8yL3VRQ0n2pRgQ2a01MJsy+WwTZCBYWf0VnLRIvANUoWQgy9vz94q7Va44dg7A1/3ICf+xAwIDAQAB
VITE_APP_RSA_PRIVATE_
