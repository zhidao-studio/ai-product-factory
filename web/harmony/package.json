{
  "name": "harmony",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "description": "RuoYi 鸿蒙端 (Taro React → HarmonyOS)",
  "template": "default",
  "scripts": {
    "build:harmony": "taro build --type harmony_cpp",
    "dev:harmony": "npm run build:harmony -- --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch",
    "type-check": "tsc --noEmit"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@tarojs/components": "^4.2.1",
    "@tarojs/helper": "^4.2.1",
    "@tarojs/plugin-framework-react": "^4.2.1",
    "@tarojs/plugin-platform-harmony-cpp": "^4.2.1",
    "@tarojs/plugin-platform-h5": "^4.2.1",
    "@tarojs/react": "^4.2.1",
    "@tarojs/runtime": "^4.2.1",
    "@tarojs/shared": "^4.2.1",
    "@tarojs/taro": "^4.2.1",
    "crypto-js": "^4.2.0",
    "jsencrypt": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.28.5",
    "@tarojs/cli": "^4.2.1",
    "@tarojs/vite-runner": "^4.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/webpack-env": "^1.18.0",
    "babel-preset-taro": "^4.2.1",
    "postcss": "^8.4.0",
    "sass": "^1.77.0",
    "typescript": "^5.6.0",
    "vite": "^4.5.14"
  }
}
